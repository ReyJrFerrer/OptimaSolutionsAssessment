{
  "name": "optima-order-sync",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k 'npm run dev -w apps/api' 'npm run dev -w apps/web'",
    "db:migrate": "tsx --env-file=.env apps/api/src/migrate.ts",
    "test": "npm run test:node && npm run test:python",
    "typecheck": "tsc --noEmit && tsc -p tests/tsconfig.json && tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "build:api": "tsc && mkdir -p dist/apps/api/src/db && cp apps/api/src/db/0001.sql dist/apps/api/src/db/0001.sql",
    "build": "npm run build:api && npm run build -w apps/web",
    "mock:send": "tsx --env-file=.env scripts/mock-webhook.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/server.js",
    "hubspot:verify": "tsx --env-file=.env scripts/verify-hubspot.ts",
    "smoke:live": "tsx --env-file=.env tests/manual/smoke-live.ts",
    "test:node": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:frontend": "vitest run tests/frontend",
    "test:python": "python3 -m unittest discover -s tests/python -p 'test_*.py'"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.0.5"
  }
}
