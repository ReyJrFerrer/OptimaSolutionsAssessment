HUBSPOT_ACCESS_TOKEN=replace-with-local-service-key
HUBSPOT_PIPELINE_ID=default
HUBSPOT_DEAL_STAGE_ID=closedwon
WEBHOOK_SECRET=replace-with-at-least-32-random-characters
DASHBOARD_ADMIN_TOKEN=replace-with-another-32-random-characters
PORT=3001
DATABASE_PATH=./data/orders.sqlite
# Set true ONLY after confirming PHP is enabled in the portal.
HUBSPOT_PHP_CONFIRMED=false

# Local Node binding; Compose overrides HOST, PORT and DATABASE_PATH internally.
HOST=127.0.0.1
# Optional Compose host-port overrides (internal API remains 3001).
# API_HOST_PORT=3001
# WEB_HOST_PORT=5173
