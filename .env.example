HUBSPOT_ACCESS_TOKEN=replace-with-local-service-key
HUBSPOT_PIPELINE_ID=default
HUBSPOT_DEAL_STAGE_ID=closedwon
WEBHOOK_SECRET=replace-with-at-least-32-random-characters
DASHBOARD_ADMIN_TOKEN=replace-with-another-32-random-characters
PORT=3001
DATABASE_PATH=./data/orders.sqlite
# Set true ONLY after confirming PHP is enabled in the portal.
HUBSPOT_PHP_CONFIRMED=false

# Local Node binding; Compose overrides HOST, PORT and DATABASE_PATH internally.
HOST=127.0.0.1
# Optional Compose host-port overrides (internal API remains 3001).
# API_HOST_PORT=3001
# WEB_HOST_PORT=5173

# Optional n8n: docker compose --profile automation up -d --wait
# If a separate n8n already owns 5678, use 5679 for a fresh independent instance.
N8N_HOST_PORT=5678
# Fresh installs use a project-scoped volume. To adopt existing data, STOP its
# previous n8n container first, then set BOTH values; never run two on one volume.
# N8N_DATA_VOLUME=optimasolutionsn8npractice_n8n_data
N8N_DATA_EXTERNAL=false
# HubSpot/HMAC/SMTP secrets are configured as credentials in n8n, not Docker env.
# Its encryption key is generated once and persisted in the n8n volume.
